{
  "name": "reservepay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "pnpm --filter @reservepay/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @reservepay/core test",
    "test:program": "anchor test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "prettier": "3.6.2",
    "ts-mocha": "10.0.0",
    "typescript": "5.9.3"
  }
}
